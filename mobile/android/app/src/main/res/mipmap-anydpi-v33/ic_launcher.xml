<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ resolves this variant when a supported launcher requests the
  monochrome layer for Material You themed icons. Keep the normal adaptive
  layers identical to the v26 resource, but provide the alpha-only glyph
  directly: some launchers do not preserve an inset wrapper when extracting a
  monochrome bitmap from an older resource variant.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="16%" />
    </foreground>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
