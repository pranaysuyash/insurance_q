# Flutter --dart-define-from-file input for test runs.
#
# Usage:
#   flutter test --dart-define-from-file=.dartdefine.env
#   flutter run   --dart-define-from-file=.dartdefine.env
#
# Required: API_BASE_URL must be a valid HTTPS URL for the default
# (production) environment.  AppConfig.baseUri throws StateError if
# this define is absent in production mode.
#
API_BASE_URL=https://api.coverwise.app
#
# Optional: override ENVIRONMENT if you need development-mode fallbacks
# (http://localhost:8000, relaxed HTTPS checks).  Note that in the
# Flutter test runner, --dart-define=ENVIRONMENT may not take effect
# due to cached compilation; prefer setting API_BASE_URL directly.
# ENVIRONMENT=development

