FROM python:3.11-slim

WORKDIR /app

# Copy only basic requirements
COPY requirements-simple.txt .

RUN pip install -r requirements-simple.txt

# Create a simple FastAPI app
COPY src/simple_app.py src/simple_app.py

ENV PYTHONPATH=/app

# Expose port 80 for Azure App Service
EXPOSE 80

# Use PORT environment variable if available, otherwise default to 80
CMD uvicorn src.simple_app:app --host 0.0.0.0 --port ${PORT:-80} 