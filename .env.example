# Runtime environment
# Production values belong in Secret Manager or an equivalent deployment
# secret store; never commit a populated production file.
ENVIRONMENT=development

# OpenAI Configuration
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-nano

# Hugging Face Configuration
HF_TOKEN=your_huggingface_token_here
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Embedding Strategy (development-only fallback controls)
# Production uses the canonical Supabase pgvector embedding space and must not
# silently mix providers or dimensions.
USE_OPENAI_FIRST=true

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=insurance_documents_v2

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL_SECONDS=3600

# Logging
LOG_LEVEL=INFO

# Supabase (fill locally; never commit real values)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supabase's modern server-only key name; the API normalizes it to the
# internal SUPABASE_SERVICE_ROLE_KEY contract.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=coverwise-documents

# Production persistence/vector contracts. Leave empty for local development;
# the application selects its documented development adapters by default.
DOCUMENT_REPOSITORY_BACKEND=
DOCUMENT_OBJECT_STORE_BACKEND=
RAG_VECTOR_BACKEND=
REVENUECAT_WEBHOOK_AUTHORIZATION=
BILLING_LEDGER_BACKEND=

# Production-only launch gates
ANONYMOUS_AUTH_SIGNING_KEY=replace_with_32_plus_character_secret
# Secret Manager only: encrypts PDF passwords/on-device OCR in durable jobs.
PROCESSING_PAYLOAD_ENCRYPTION_KEY=replace_with_32_plus_character_secret
PUBLIC_SITE_URL=https://your-production-origin.example
ALLOWED_ORIGINS=https://your-production-origin.example
