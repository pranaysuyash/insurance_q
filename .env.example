# CoverWise environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# ── Environment ──
ENVIRONMENT=development  # or "production"

# ── OpenAI (required for embeddings + chat) ──
OPENAI_API_KEY=sk-proj-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5-nano

# ── Groq (optional — LLM fallback, free dev tier) ──
# Get key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ── Ollama (local dev only — fallback embeddings + chat) ──
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Qdrant (vector DB) ──
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=insurance_documents_v2
# For cloud Qdrant:
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your-key

# ── Redis (cache + rate limiting) ──
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL_SECONDS=3600

# ── Supabase (required for production) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...  # anon key — safe for mobile, RLS-respecting
# The server-only key has TWO accepted names because Supabase renamed the key
# format. Set ONLY ONE of these, to the SAME value — your project's server key
# from Dashboard → Settings → API → "service_role" secret (legacy) or
# "secret" key (current format, starts with sb_secret_). Do not set both to
# different values. The backend reads SUPABASE_SERVICE_ROLE_KEY first and falls
# back to SUPABASE_SECRET_KEY (see src/utils/runtime_config.py).
SUPABASE_SECRET_KEY=sb_secret_...            # server-only, never in mobile
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...    # alias; same value as SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=coverwise-documents
# SUPABASE_EXPERIMENTAL_API_KEY=sbp_v0_...   # 30-day management API token

# ── Anonymous auth (generate with: openssl rand -hex 32) ──
ANONYMOUS_AUTH_SIGNING_KEY=your-random-64-char-hex-string

# ── Storage backends (dev=local, prod=supabase) ──
DOCUMENT_REPOSITORY_BACKEND=sqlite     # or "supabase"
DOCUMENT_OBJECT_STORE_BACKEND=local    # or "supabase"
RAG_VECTOR_BACKEND=qdrant              # or "supabase" (pgvector)

# ── Production security ──
ALLOWED_ORIGINS=https://your-domain.com
ALLOWED_HOSTS=api.your-domain.com
PUBLIC_SITE_URL=https://coverwise.app

# ── Billing (RevenueCat) ──
# REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer_rc_key

# ── Processing encryption (generate with: openssl rand -hex 16) ──
# PROCESSING_PAYLOAD_ENCRYPTION_KEY=your-32-char-hex-string

# ── Backend mode selectors (dev defaults, must be supabase for production) ──
BILLING_LEDGER_BACKEND=sqlite     # or "supabase"

# ── Error tracking (Sentry) ──
# Backend (FastAPI/Python) DSN — set in .env for server-side crash tracking.
# The SDK is silently disabled when this is empty (safe for dev).
SENTRY_DSN=https://your-python-dsn@sentry.io/project_id
#
# Mobile (Flutter) DSN — injected at build time via:
#   flutter build --dart-define=SENTRY_DSN=https://your-flutter-dsn@sentry.io/project_id
# Not read from .env. The SDK is silently disabled when the DSN is empty.

# ── Logging ──
LOG_LEVEL=INFO
